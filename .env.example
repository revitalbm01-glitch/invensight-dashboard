# צרו קובץ .env (לא .env.example) עם הערכים האמיתיים שלכם — הקובץ .env לא נכנס ל-git.
#
# VITE_AIRTABLE_API_KEY: Personal Access Token מ-Airtable
#   https://airtable.com/create/tokens — עם הרשאות data.records:read על הבסיס הרלוונטי.
# VITE_AIRTABLE_BASE_ID: מזהה הבסיס (מתחיל ב-app...), נמצא בכתובת ה-URL של הבסיס או ב-API docs שלו.
#
# אזהרה: מכיוון שזה אתר סטטי (Vite + GitHub Pages), כל משתנה שמתחיל ב-VITE_
# נאפה בפועל לתוך קובץ ה-JS הציבורי בעת build. אל תרוצו `npm run deploy` כל עוד
# משתנים אלו מוגדרים - זה יחשוף את ה-API key שלכם לכל מי שיפתח את האתר.
# להרצה מקומית (npm run dev) בלבד זה בטוח.

VITE_AIRTABLE_API_KEY=
VITE_AIRTABLE_BASE_ID=
